# Copy to .env and adjust. Every value has a working default; nothing here is
# required to run locally.

# --- storage -----------------------------------------------------------------
# SQLite by default (a file under var/). Point at PostgreSQL for anything shared:
#   DLG_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/demand
DLG_DATABASE_URL=sqlite:///./var/demand.db
DLG_STORAGE_ROOT=./var/storage
DLG_MAX_UPLOAD_BYTES=52428800

# Create tables from the models at startup. Convenient for a first run; set to 0
# in a deployment so a missing migration fails loudly instead of being papered
# over by a silently created table. Migrations: `make migrate`.
DLG_AUTO_CREATE_SCHEMA=1

# --- background work ---------------------------------------------------------
# thread = run jobs on a worker thread of this API process (default)
# inline = run them synchronously on submit (tests, scripts)
# A job is bound to the process that accepted it; a multi-process deployment
# needs a real queue. See the docstring in apps/api/app/jobs/runner.py.
DLG_JOB_RUNNER=thread

# --- AI drafting -------------------------------------------------------------
# stub           = deterministic offline drafter; assembles prose from verified
#                  facts. No network, no key. Use this for local work and tests.
# secure_gateway = the preferred external path. Prompts cross the Secure AI
#                  Gateway's privacy pipeline and the draft is the restored
#                  response.
# anthropic      = Claude via the official SDK, calling the vendor DIRECTLY and
#                  BYPASSING the privacy gateway. Explicit opt-in only; it is
#                  never selected automatically and never used as a fallback.
DLG_LLM_PROVIDER=stub

# pattern        = deterministic offline extractor; reads labelled patterns
# secure_gateway = extraction through the privacy gateway
# anthropic      = Claude directly, bypassing the gateway
DLG_EXTRACTION_PROVIDER=pattern

# --- Secure AI Gateway -------------------------------------------------------
# The privacy boundary for external model calls. This service calls it
# server-to-server; the browser never does, and the key below must NEVER be
# exposed to the frontend. There is no NEXT_PUBLIC_ variant of it, and adding
# one would publish the credential to every visitor.
#
# Operational constraints of the deployment:
#   * rate limiting is per authenticated principal -> HTTP 429 RATE_LIMIT_EXCEEDED
#   * ordinary request bodies are capped at 256 KB -> HTTP 413 REQUEST_TOO_LARGE
#   * document uploads use separate endpoints and are not used by this service
SECURE_GATEWAY_URL=https://sgw-api.onrender.com
SECURE_GATEWAY_API_KEY=
# Must be an alias the gateway allows for this key. Ask it:
#   curl -H "Authorization: Bearer $SECURE_GATEWAY_API_KEY" #        https://sgw-api.onrender.com/v1/providers
# The deployment currently offers: mock/general-chat and openai/{default,fast}.
SECURE_GATEWAY_PROVIDER=openai
SECURE_GATEWAY_MODEL=default
SECURE_GATEWAY_TIMEOUT_SECONDS=60
SECURE_GATEWAY_MAX_OUTPUT_TOKENS=2000

# Direct vendor access, retained for continuity. Bypasses the gateway.
DLG_ANTHROPIC_MODEL=claude-opus-5
DLG_ANTHROPIC_EFFORT=high
# ANTHROPIC_API_KEY=sk-ant-...

# --- letterhead --------------------------------------------------------------
# Used by the built-in layout and by the {{firm_name}} template slot.
DLG_FIRM_NAME=Stalwart Law Group
DLG_FIRM_ADDRESS=1055 W 7th St, Suite 2800|Los Angeles, CA 90017
DLG_FIRM_PHONE=(213) 000-0000
DLG_FIRM_EMAIL=claims@example-firm.test

# --- browser access ----------------------------------------------------------
# Explicit origins allowed to call the API from a browser (pipe-separated).
# Never a wildcard; credentials are off because auth travels in headers.
DLG_CORS_ORIGINS=http://localhost:3000|http://127.0.0.1:3000

# --- security ----------------------------------------------------------------
# Set to a clamd host to make uploads fail closed until a scanner is wired up.
# DLG_CLAMAV_HOST=127.0.0.1
